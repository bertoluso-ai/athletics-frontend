# Copiar a deploy/.env en el servidor y rellenar (NO subir a git). Los valores son los mismos que en Vercel.
SITE_USER=
SITE_PASSWORD=
# SITE_PUBLIC=1        # solo cuando se abra la web al publico a proposito
PG_SERVING_USER=serving_ro
PG_SERVING_PASSWORD=
# Certificado del servidor Postgres en PEM con los saltos de linea escritos como \n (igual que en Vercel)
PG_SERVING_CA=
NEXT_PUBLIC_GTM_ID=
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_ADSENSE_PUB=
